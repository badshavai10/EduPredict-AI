# ==========================================
# EduPredict AI — Environment Configuration
# ==========================================

# Environment Mode
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://edupredict_user:secure_password@localhost:5432/edupredict_db?schema=public"

# Better Auth Authentication
BETTER_AUTH_SECRET="replace-with-a-secure-random-32-char-secret-key"
BETTER_AUTH_URL="http://localhost:5000"

# Client Frontend URL (for CORS and API requests)
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_APP_NAME="EduPredict AI"
